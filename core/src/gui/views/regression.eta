<% if (it.csrfToken) { %><meta name="csrf-token" content="<%= it.csrfToken %>" /><% } %>

<div class="page-header">
  <h1>Regression Suite</h1>
</div>

<nav class="regression-tabs" aria-label="Regression views">
  <a href="/gui/regression?view=overview" <% if (it.activeView === 'overview') { %>aria-current="page"<% } %>>Overview</a>
  <a href="/gui/regression?view=trends" <% if (it.activeView === 'trends') { %>aria-current="page"<% } %>>Trends</a>
  <a href="/gui/regression?view=compare" <% if (it.activeView === 'compare') { %>aria-current="page"<% } %>>Compare</a>
  <a href="/gui/regression?view=run" <% if (it.activeView === 'run') { %>aria-current="page"<% } %>>Run</a>
</nav>

<section id="regression-live" data-runid="<%= it.activeRunId || '' %>" hidden></section>

<div id="regression-tab-content">
<% if (it.activeView === 'overview') { %>
  <%~ include('partials/regression-tab-overview', it) %>
<% } else if (it.activeView === 'trends') { %>
  <%~ include('partials/regression-tab-trends', it) %>
<% } else if (it.activeView === 'run') { %>
  <%~ include('partials/regression-tab-run', it) %>
<% } else { %>
  <%~ include('partials/regression-tab-compare', it) %>
<% } %>
</div>

<aside id="regression-drilldown" hidden></aside>

<%~ include('partials/regression-live') %>
