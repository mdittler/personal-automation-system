<%~ include('regression-summary-bar', {
  modelIds: it.modelIds,
  estimate: it.estimate,
  selectedBucket: it.selectedBucket,
  activeRunId: it.activeRunId,
}) %>

<% if (it.discoveryError) { %>
  <article class="error-banner" role="alert" data-testid="discovery-error">
    <strong>Failed to enumerate cases.</strong>
    <p><%= it.discoveryError %></p>
    <small>Run controls are disabled until this resolves. Check the server log and rerun <code>pnpm test:regression -- --list --json</code>.</small>
  </article>
<% } %>

<nav class="bucket-filter" aria-label="Filter by bucket">
  <a href="/gui/regression?view=compare" <% if (!it.selectedBucket) { %>aria-current="page"<% } %>>All</a>
  <a href="/gui/regression?view=compare&bucket=routing" <% if (it.selectedBucket === 'routing') { %>aria-current="page"<% } %>>Routing</a>
  <a href="/gui/regression?view=compare&bucket=receipt" <% if (it.selectedBucket === 'receipt') { %>aria-current="page"<% } %>>Receipt</a>
  <a href="/gui/regression?view=compare&bucket=chatbot" <% if (it.selectedBucket === 'chatbot') { %>aria-current="page"<% } %>>Chatbot</a>
  <a href="/gui/regression?view=compare&bucket=recall" <% if (it.selectedBucket === 'recall') { %>aria-current="page"<% } %>>Recall</a>
</nav>

<form method="get" action="/gui/regression" class="compare-filter-form" aria-label="Compare filters">
  <input type="hidden" name="view" value="compare" />
  <% if (it.selectedBucket) { %><input type="hidden" name="bucket" value="<%= it.selectedBucket %>" /><% } %>
  <label>
    Model
    <input type="text" name="model" value="<%= (it.compareFilters && it.compareFilters.model) || '' %>" placeholder="provider/model" autocomplete="off" data-testid="compare-filter-model" />
  </label>
  <label>
    Verdict
    <select name="verdict" data-testid="compare-filter-verdict">
      <option value="" <% if (!it.compareFilters || !it.compareFilters.verdict) { %>selected<% } %>>All</option>
      <option value="pass" <% if (it.compareFilters && it.compareFilters.verdict === 'pass') { %>selected<% } %>>pass</option>
      <option value="fail" <% if (it.compareFilters && it.compareFilters.verdict === 'fail') { %>selected<% } %>>fail</option>
      <option value="error" <% if (it.compareFilters && it.compareFilters.verdict === 'error') { %>selected<% } %>>error</option>
      <option value="budget-exceeded" <% if (it.compareFilters && it.compareFilters.verdict === 'budget-exceeded') { %>selected<% } %>>budget-exceeded</option>
    </select>
  </label>
  <label>
    Case ID
    <input type="text" name="caseId" value="<%= (it.compareFilters && it.compareFilters.caseId) || '' %>" placeholder="exact case-id match" autocomplete="off" data-testid="compare-filter-case-id" />
  </label>
  <button type="submit">Apply</button>
  <% if (it.compareFilters && (it.compareFilters.model || it.compareFilters.verdict || it.compareFilters.caseId)) { %>
    <a href="/gui/regression?view=compare<% if (it.selectedBucket) { %>&bucket=<%= it.selectedBucket %><% } %>" data-testid="compare-filter-clear">Clear filters</a>
  <% } %>
</form>

<% if (it.historicalRows && Array.isArray(it.historicalRows)) { %>
  <article class="historical-view" aria-label="Cross-run history">
    <h3>All runs for <code><%= it.historicalCaseId %></code></h3>
    <% if (it.historicalRows.length === 0) { %>
      <p class="empty-state" data-testid="historical-empty">No cached runs for this case yet.</p>
    <% } else { %>
      <table class="regression-table" data-testid="historical-table">
        <thead>
          <tr>
            <th>Timestamp</th>
            <th>Verdict</th>
            <th>Fast model</th>
            <th>Standard model</th>
            <th>Reasoning model</th>
            <th>Cost</th>
            <th>Cache key</th>
          </tr>
        </thead>
        <tbody>
          <% for (const r of it.historicalRows) { %>
            <tr data-testid="historical-row">
              <td><time datetime="<%= r.timestamp %>"><%= r.timestamp %></time></td>
              <td><%= r.verdict %></td>
              <td><code><%= r.modelFast %></code></td>
              <td><code><%= r.modelStandard %></code></td>
              <td><code><%= r.modelReasoning %></code></td>
              <td>$<%= r.costUsd %></td>
              <td><small><code><%= r.cacheKey.slice(0, 12) %>…</code></small></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </article>
<% } else if (it.cases.length === 0) { %>
  <p class="empty-state">No cases in this bucket. Add cases under <code>regression/src/cases/&lt;bucket&gt;/</code>.</p>
<% } else { %>
  <table class="regression-table">
    <thead>
      <tr>
        <th>Status</th>
        <th>Case</th>
        <th>Bucket</th>
        <th>Fast model</th>
        <th>Standard model</th>
        <th>Cost</th>
        <th>Tokens</th>
        <th>Timestamp</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% for (const c of it.cases) { %>
        <%~ include('regression-case-row', { case: c }) %>
      <% } %>
    </tbody>
  </table>
<% } %>

<footer class="regression-footnote">
  <small>
    Cost is authoritative via CostTracker. Token counts show totals across all LLM calls for the case.
  </small>
</footer>
