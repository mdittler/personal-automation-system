<script>
// Regression suite client wiring. Intercepts the run forms, runs the
// estimate → confirm → POST /runs flow, opens EventSource, fetches per-case
// row partials on case-completed, renders terminal banners, exposes a Cancel
// button. Vanilla JS — htmx auto-injects CSRF on hx-* requests but our own
// POSTs set X-CSRF-Token explicitly.
//
// Reconnect: the browser's EventSource auto-retries using the server's
// `retry:` directive and sends `Last-Event-ID` on each reconnect so missed
// events replay. After 3 consecutive `error`s with no intervening `open`,
// show "Lost connection — reload". A `gap` event (server's ring buffer
// evicted the requested id) reloads the page. Terminal events close the
// EventSource explicitly so no reconnect fires after the run ends.
(function () {
	const live = document.getElementById('regression-live');
	if (!live) return;
	let es = null;
	let activeRunId = null;
	let failureCount = 0;
	let terminalReached = false;

	function csrfHeader() {
		const meta = document.querySelector('meta[name="csrf-token"]');
		return meta ? meta.getAttribute('content') : '';
	}

	function setState(label) {
		const el = live.querySelector('.run-state');
		if (el) el.textContent = label;
	}

	function showRunBanner(runId) {
		activeRunId = runId;
		live.dataset.runid = runId;
		live.hidden = false;
		live.innerHTML =
			'<article class="run-banner">' +
			'<strong>Run ' + runId.slice(0, 8) + '</strong> — <span class="run-state">starting</span> ' +
			'<button type="button" class="cancel-btn outline secondary">Cancel</button>' +
			'<div class="terminal-msg" hidden></div>' +
			'<div class="connection-msg" hidden></div>' +
			'</article>';
		const btn = live.querySelector('.cancel-btn');
		btn.addEventListener('click', cancelActive);
	}

	// `payload` is either a plain string (failed / cancelled) or a structured
	// banner object {stateLabel, headline, lines[], hint?} formatted server-side
	// (terminal-banner.ts). The CSS class is always `terminal-<stateClass>` —
	// decoupled from the human-readable state label.
	function showTerminal(stateClass, payload) {
		terminalReached = true;
		const isBanner = payload && typeof payload === 'object';
		setState(isBanner ? (payload.stateLabel || stateClass) : stateClass);
		const btn = live.querySelector('.cancel-btn');
		if (btn) btn.disabled = true;
		const m = live.querySelector('.terminal-msg');
		if (m) {
			m.hidden = false;
			m.className = 'terminal-msg terminal-' + stateClass;
			// Built via DOM APIs (textContent per node) — never innerHTML — so
			// server-formatted strings cannot inject markup.
			m.textContent = '';
			if (isBanner) {
				const h = document.createElement('strong');
				h.textContent = payload.headline || '';
				m.appendChild(h);
				const lines = Array.isArray(payload.lines) ? payload.lines : [];
				lines.forEach(function (line) {
					const d = document.createElement('div');
					d.textContent = line;
					m.appendChild(d);
				});
				if (payload.hint) {
					const hint = document.createElement('div');
					hint.className = 'terminal-hint';
					hint.textContent = payload.hint;
					m.appendChild(hint);
				}
			} else {
				m.textContent = String(payload == null ? '' : payload);
			}
		}
		if (es) { es.close(); es = null; }
	}

	function showLostConnection() {
		const m = live.querySelector('.connection-msg');
		if (!m) return;
		m.hidden = false;
		m.className = 'connection-msg connection-lost';
		// Built via DOM APIs to keep the page CSP-friendly (no inline script,
		// no javascript: URLs) and to avoid an innerHTML write that future
		// linters might flag.
		m.textContent = '';
		m.appendChild(document.createTextNode('Lost connection — '));
		const btn = document.createElement('button');
		btn.type = 'button';
		btn.className = 'reload-btn outline';
		btn.textContent = 'Reload';
		btn.addEventListener('click', function () { window.location.reload(); });
		m.appendChild(btn);
	}

	function attach(runId, eventsUrl) {
		showRunBanner(runId);
		failureCount = 0;
		terminalReached = false;
		if (es) es.close();
		es = new EventSource(eventsUrl);
		es.addEventListener('open', function () {
			// Successful (re)connection — reset the failure counter so a single
			// transient blip during a long run doesn't trip the 3-strike banner.
			failureCount = 0;
		});
		es.addEventListener('gap', function () {
			// Server-side ring buffer evicted the requested Last-Event-ID.
			// Full reload re-renders the page with current cached state and
			// re-attaches with no Last-Event-ID (full replay from current log).
			window.location.reload();
		});
		es.addEventListener('error', function () {
			if (terminalReached) {
				// EventSource may fire `error` after we close it on a terminal
				// event. Ignore — we don't want to reconnect or show a banner.
				return;
			}
			failureCount += 1;
			if (failureCount >= 3) {
				showLostConnection();
				if (es) { es.close(); es = null; }
			}
			// Otherwise let the browser auto-retry using the server's `retry:`
			// directive (3000ms).
		});
		es.addEventListener('case-completed', async function (e) {
			let payload;
			try { payload = JSON.parse(e.data); } catch (_) { return; }
			const caseId = payload && payload.caseId;
			if (!caseId) return;
			const url = '/gui/regression/cases/' + encodeURIComponent(caseId) +
				'/row?runId=' + encodeURIComponent(runId);
			const res = await fetch(url, { headers: { Accept: 'text/html' } });
			if (!res.ok) return;
			const html = await res.text();
			const row = document.getElementById('row-' + caseId);
			if (row) row.outerHTML = html;
		});
		es.addEventListener('summary', function () { setState('finalising'); });
		es.addEventListener('complete', function (e) {
			let banner = null;
			try { banner = (JSON.parse(e.data) || {}).banner || null; } catch (_) {}
			showTerminal('complete', banner || 'Run complete.');
			// REQ-REG-GUI-V2-018: poll /summary for each visible tier cell once
			// the run completes. The server's onTerminal hook has already
			// scheduled summarization; the polled GET picks up the persisted
			// JSON as it lands.
			pollWeaknessSummaries(activeRunId);
		});
		es.addEventListener('gate-failed', function (e) {
			let banner = null;
			try { banner = (JSON.parse(e.data) || {}).banner || null; } catch (_) {}
			// gate-failed means the suite RAN — the model under test scored below
			// the REQ-REG-011 bar. The server-formatted banner says exactly that.
			showTerminal('gate-failed', banner || 'REQ-REG-011 accuracy gate not met.');
			// Gate failure still produces a manifest (REQ-REG-011 ran but the
			// gate fired); summarizing those failures is exactly the
			// most-useful case for operators.
			pollWeaknessSummaries(activeRunId);
		});
		es.addEventListener('failed', function (e) {
			let payload = {};
			try { payload = JSON.parse(e.data) || {}; } catch (_) {}
			showTerminal('failed', 'Run failed (exit ' + (payload.exitCode || '?') + ').');
		});
		es.addEventListener('cancelled', function () { showTerminal('cancelled', 'Run cancelled.'); });
	}

	function pollWeaknessSummaries(runId) {
		if (!runId) return;
		const cells = document.querySelectorAll('[data-testid="weakness-summary-cell"][data-runid="' + runId + '"]');
		if (!cells.length) return;
		const deadline = Date.now() + 30000; // 30s cap
		cells.forEach(function (cell) {
			const tier = cell.dataset.tier;
			if (!tier) return;
			const tick = async function () {
				try {
					const res = await fetch('/gui/regression/runs/' + encodeURIComponent(runId) + '/summary?tier=' + encodeURIComponent(tier), { headers: { Accept: 'text/html' } });
					if (res.status === 200) {
						const html = await res.text();
						cell.innerHTML = html;
						return; // done
					}
					if (res.status === 202 && Date.now() < deadline) {
						setTimeout(tick, 2000);
						return;
					}
					cell.innerHTML = '<small>summary unavailable</small>';
				} catch (_) {
					cell.innerHTML = '<small>summary unavailable</small>';
				}
			};
			tick();
		});
	}

	async function cancelActive() {
		if (!activeRunId) return;
		await fetch('/gui/regression/runs/' + encodeURIComponent(activeRunId) + '/cancel', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfHeader() },
			body: '{}',
		});
	}

	function fdToBody(fd) {
		const body = {};
		const reruns = [];
		for (const [k, v] of fd.entries()) {
			if (k === '_csrf') continue;
			if (k === 'rerun') reruns.push(String(v));
			else body[k] = String(v);
		}
		if (reruns.length > 0) body.rerun = reruns;
		return body;
	}

	function fdToEstimateQuery(fd) {
		const params = new URLSearchParams();
		const bucket = fd.get('bucket');
		if (bucket) params.set('bucket', String(bucket));
		for (const r of fd.getAll('rerun')) params.append('rerun', String(r));
		return params;
	}

	async function submitRun(form, event) {
		event.preventDefault();
		const fd = new FormData(form);
		// Confirm with the operator using a fresh estimate.
		try {
			const res = await fetch('/gui/regression/estimate?' + fdToEstimateQuery(fd), {
				headers: { Accept: 'application/json' },
			});
			const est = res.ok ? await res.json() : null;
			const total = est && typeof est.totalUsd === 'number' ? est.totalUsd.toFixed(2) : '?';
			const cap = est && typeof est.ceilingUsd === 'number' ? est.ceilingUsd.toFixed(2) : '?';
			const cases = est && typeof est.totalCases === 'number' ? est.totalCases : '?';
			const inputs = est && typeof est.totalInputs === 'number' ? est.totalInputs : null;
			// REQ-REG-GUI-V2-023: show both case + input counts so operators know
			// the real dispatch fan-out (FOOD_PERSONAS = 27 cases × ~4 inputs).
			const summary = inputs !== null
				? 'Run ' + inputs + ' input(s) across ' + cases + ' case(s)?'
				: 'Run ' + cases + ' case(s)?';
			if (!confirm(summary + ' Estimated cost ≈ $' + total + ' (cap $' + cap + ').')) {
				return;
			}
		} catch (_) {
			if (!confirm('Run the regression suite? (estimate unavailable)')) return;
		}
		const post = await fetch('/gui/regression/runs', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfHeader() },
			body: JSON.stringify(fdToBody(fd)),
		});
		if (post.status === 409) {
			const j = await post.json().catch(function () { return {}; });
			if (j && j.activeRunId) {
				if (confirm('A run is already in progress. Attach to the live stream?')) {
					attach(j.activeRunId, '/gui/regression/runs/' + encodeURIComponent(j.activeRunId) + '/events');
				}
			}
			return;
		}
		if (!post.ok) {
			const j = await post.json().catch(function () { return {}; });
			alert('Failed to start run: ' + ((j && j.error) || post.status));
			return;
		}
		const body = await post.json();
		if (body && body.runId && body.eventsUrl) attach(body.runId, body.eventsUrl);
	}

	function wireForm(form) {
		form.addEventListener('submit', function (e) { submitRun(form, e); });
	}

	document
		.querySelectorAll('form[action="/gui/regression/runs"]')
		.forEach(wireForm);

	const preExisting = live.dataset.runid;
	if (preExisting) attach(preExisting, '/gui/regression/runs/' + encodeURIComponent(preExisting) + '/events');
})();
</script>
