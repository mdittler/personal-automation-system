<div class="page-header">
  <h1><%= it.session.title %></h1>
  <div class="actions">
    <a href="/gui/sessions" role="button" class="outline secondary">Back to Conversations</a>
  </div>
</div>

<p style="color:var(--pico-muted-color)">
  Started <%= new Date(it.session.startedAt).toLocaleString() %>. Read-only — this is a record of what was said.
</p>

<% if (it.messages.length === 0) { %>
  <p class="empty-state">No messages recorded for this conversation.</p>
<% } else { %>
  <div class="pas-transcript">
    <% for (const message of it.messages) { %>
      <div class="pas-transcript-message pas-transcript-<%= message.role %>">
        <strong><%= message.role === 'user' ? 'You' : 'Bot' %></strong>
        <small style="color:var(--pico-muted-color);margin-left:0.5rem"><%= new Date(message.timestamp).toLocaleString() %></small>
        <p><%= message.text %></p>
      </div>
    <% } %>
  </div>
<% } %>
