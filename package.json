{
	"name": "personal-automation-system",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A local-first home automation platform with modular apps, Telegram interface, and LLM integration",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"packageManager": "pnpm@10.30.3",
	"scripts": {
		"build": "pnpm -r run build",
		"dev": "tsx watch core/src/bootstrap.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:hooks": "bash .claude/hooks/test-biome-hooks.sh",
		"auth:set-password": "tsx core/src/cli/auth-set-password.ts",
		"scaffold-app": "tsx core/src/cli/scaffold-app.ts",
		"install-app": "tsx core/src/cli/install-app.ts",
		"uninstall-app": "tsx core/src/cli/uninstall-app.ts",
		"migrate-frontmatter": "tsx scripts/migrate-frontmatter.ts",
		"load-test": "tsx scripts/load-test.ts",
		"analyze-shadow-log": "tsx scripts/analyze-shadow-log.ts",
		"analyze-session-control-log": "tsx scripts/analyze-session-control-log.ts",
		"chat-index-rebuild": "tsx scripts/chat-index-rebuild.ts",
		"chat-index-prune": "tsx scripts/chat-index-prune.ts",
		"test:regression": "tsx --tsconfig regression/tsconfig.test.json regression/src/runner/cli-main.ts",
		"typecheck:fixtures": "pnpm --filter @pas/core typecheck:fixtures",
		"prepare": "bash .claude/hooks/install-git-hooks.sh"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "better-sqlite3", "esbuild"]
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"pino": "^10.3.1",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"cron-parser": "^5.5.0",
		"cronstrue": "^3.13.0",
		"zod": "^3.23.0"
	}
}
